# Configurações para desenvolvimento local
# Copie este arquivo para .env e ajuste as variáveis conforme necessário

# MongoDB - Use sua string de conexão local ou do MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/treinoTech

# JWT
JWT_SECRET=minha_chave_secreta_super_segura_para_development
JWT_EXPIRES_IN=1d

# Porta do servidor local
PORT=5000
